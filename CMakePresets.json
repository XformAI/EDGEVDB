{
  "version": 3,
  "configurePresets": [
    {
      "name": "desktop-debug",
      "generator": "Ninja",
      "binaryDir": "build/desktop-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "desktop-release",
      "generator": "Ninja",
      "binaryDir": "build/desktop-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-O3 -DNDEBUG"
      }
    },
    {
      "name": "android-arm64",
      "generator": "Ninja",
      "binaryDir": "build/android-arm64",
      "toolchainFile": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-x86_64",
      "generator": "Ninja",
      "binaryDir": "build/android-x86_64",
      "toolchainFile": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64",
        "ANDROID_PLATFORM": "android-26",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ios-arm64",
      "generator": "Unix Makefiles",
      "binaryDir": "build/ios-arm64",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-arch arm64 -isysroot $(xcrun --sdk iphoneos --show-sdk-path)"
      }
    },
    {
      "name": "ios-simulator-x86_64",
      "generator": "Unix Makefiles",
      "binaryDir": "build/ios-simulator-x86_64",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-arch x86_64 -isysroot $(xcrun --sdk iphonesimulator --show-sdk-path)"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop-debug",
      "configurePreset": "desktop-debug"
    },
    {
      "name": "desktop-release",
      "configurePreset": "desktop-release"
    },
    {
      "name": "ios-arm64",
      "configurePreset": "ios-arm64"
    },
    {
      "name": "ios-simulator-x86_64",
      "configurePreset": "ios-simulator-x86_64"
    }
  ]
}
